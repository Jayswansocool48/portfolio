---
import { href } from "@/lib/utils";
import { STUDIO, SOCIAL_NAMES } from "@/data/catalog";
const socials = Object.entries(STUDIO.socials).filter(([, u]) => u);
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t">
  <div class="wrap grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr]">
    <div>
      <p class="m-0 font-display text-2xl font-extrabold uppercase tracking-wide">Iron Lantern Studios</p>
      <p class="m-0 mt-2 max-w-[34ch] text-sm text-muted-foreground">Low-poly horror games and the 3D assets behind them, made by {STUDIO.owner}.</p>
    </div>
    <nav aria-label="Site" class="flex flex-col">
      <p class="eyebrow m-0 mb-2 text-muted-foreground">Site</p>
      {[["games","Games"],["store","Store"],["about","About"],["contact","Contact"]].map(([p,l]) => (
        <a href={href(p)} class="inline-flex min-h-10 items-center hover:text-primary-text">{l}</a>
      ))}
    </nav>
    <nav aria-label="Legal" class="flex flex-col">
      <p class="eyebrow m-0 mb-2 text-muted-foreground">Legal</p>
      {[["privacy","Privacy"],["terms","Terms"],["refunds","Refunds"]].map(([p,l]) => (
        <a href={href(p)} class="inline-flex min-h-10 items-center hover:text-primary-text">{l}</a>
      ))}
    </nav>
    {socials.length > 0 && (
      <nav aria-label="Elsewhere" class="flex flex-col">
        <p class="eyebrow m-0 mb-2 text-muted-foreground">Elsewhere</p>
        {socials.map(([k, u]) => <a href={u} rel="noopener me" class="inline-flex min-h-10 items-center hover:text-primary-text">{SOCIAL_NAMES[k] || k}</a>)}
      </nav>
    )}
  </div>
  <div class="wrap border-t py-5 text-sm text-muted-foreground">
    <span class="num">© {year}</span> Iron Lantern Studios
  </div>
</footer>
