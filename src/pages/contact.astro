---
import Base from "@/layouts/Base.astro";
import ContactForm from "@/components/ContactForm";
import CopyButton from "@/components/CopyButton";
import { STUDIO, SOCIAL_NAMES } from "@/data/catalog";
const socials = Object.entries(STUDIO.socials).filter(([, u]) => u);
---
<Base title="Contact" description="Get in touch with Iron Lantern Studios about custom assets, the games or working together.">
  <section class="wrap pb-10 pt-20">
    <p class="eyebrow m-0" data-reveal>Contact</p>
    <h1 data-words class="m-0 mt-3 font-display text-[clamp(3.4rem,9vw,7.5rem)] font-black uppercase leading-[0.85] tracking-wide">Let's talk</h1>
    <p class="m-0 mt-5 max-w-[48ch] text-lg text-muted-foreground" data-reveal>Want a custom asset, a hand on your game, or to team up on something? I usually reply within two days.</p>
  </section>
  <section class="wrap grid items-start gap-12 lg:grid-cols-[1fr_1.15fr]">
    <div data-reveal>
      <dl class="m-0 border-t">
        <div class="grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-1 border-b py-4">
          <dt class="eyebrow col-span-2 text-muted-foreground">Email</dt>
          <dd class="m-0 min-w-0 break-all font-semibold"><a href={`mailto:${STUDIO.email}`} class="hover:text-primary">{STUDIO.email}</a></dd>
          <CopyButton client:visible value={STUDIO.email} label="email address" />
        </div>
        <div class="grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-1 border-b py-4">
          <dt class="eyebrow col-span-2 text-muted-foreground">Discord</dt>
          <dd class="m-0 font-semibold">{STUDIO.discord}</dd>
          <CopyButton client:visible value={STUDIO.discord} label="Discord name" />
        </div>
      </dl>
      {socials.length > 0 && (
        <div class="mt-8">
          <p class="eyebrow m-0 text-muted-foreground">Elsewhere</p>
          <ul class="m-0 mt-2 list-none p-0">
            {socials.map(([k, u]) => <li><a href={u} rel="noopener me" class="inline-flex min-h-11 items-center hover:text-primary">{SOCIAL_NAMES[k] || k}</a></li>)}
          </ul>
        </div>
      )}
    </div>
    <div data-reveal><ContactForm client:visible email={STUDIO.email} /></div>
  </section>
</Base>
